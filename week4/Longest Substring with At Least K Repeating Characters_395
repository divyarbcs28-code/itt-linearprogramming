class Solution {
    public int longestSubstring(String s, int k) {
        return helper(s,0,s.length(),k);
    }

    int helper(String s,int start,int end,int k){
        if(end-start<k)
            return 0;
        
        int count[]=new int[26];
        for(int i=start;i<end;i++){
            count[s.charAt(i)-'a']++;
        }

        for(int i=start;i<end;i++){
            char c = s.charAt(i);
            if(count[c-'a']>0 && count[c-'a']<k){
                int leftpart = helper(s,start,i,k);
                int rightpart = helper(s,i+1,end,k);
                return Math.max(leftpart,rightpart);
            }
        }
        
        return end-start;
    }

}
